# ==============================================================================
# EstatePulse Brokerage Pro - Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` or `.env` and populate the values for local development.
# For production deployment (e.g. Vercel), configure these in Project Settings → Environment Variables.
#
# NOTE: All client-exposed variables in Vite must start with the `VITE_` prefix.
# ==============================================================================

# Supabase Project URL
# Description: The REST & Realtime API base URL for your Supabase backend project.
# Where to find: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase Anonymous Public Key
# Description: The anon/public API key used by the client for authenticated and public requests.
# Where to find: Supabase Dashboard → Project Settings → API → Project API Keys → `anon` public key
VITE_SUPABASE_ANON_KEY=

# Stripe Publishable Key
# Description: Public client-side key used by Stripe.js to process checkouts and billing portals.
# Where to find: Stripe Dashboard → Developers → API keys → Publishable key (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Gemini API Key (SERVER-SIDE ONLY)
# Do NOT prefix with VITE_: Vite bundles every VITE_* variable into the public JS, exposing the key.
# Set GEMINI_API_KEY in Vercel/Supabase (Edge Function secret) and call Gemini from a server route.
# GEMINI_API_KEY=
